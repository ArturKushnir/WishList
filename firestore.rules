rules_version = '2';
// Мінімальні правила: читати й писати товари та бронювання може будь-хто.
// Вставити в Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{id} {
      allow read, write: if true;
    }
    match /reservations/{id} {
      allow read, write: if true;
    }
  }
}
